@model UploadViewModel
@{
    ViewData["Title"] = "Upload & Analyze"; Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">

        <div class="page-header justify-content-center text-center d-block mb-4">
            <h1 class="page-title justify-content-center">
                <span class="page-title-icon"><i class="bi bi-cpu-fill"></i></span>
                <span class="ms-2">Analyze a Research Paper</span>
            </h1>
            <p class="mt-2" style="color:var(--text-muted);font-size:.875rem">
                Upload your PDF and let AI extract summary, keywords, key points &amp; structure.
            </p>
        </div>

        <div class="glass-card fade-in">
            <div class="card-header-custom header-accent">
                <i class="bi bi-cloud-upload-fill"></i> Upload PDF
            </div>
            <div class="p-4">
                <form asp-controller="Paper" asp-action="Upload"
                      method="post" enctype="multipart/form-data" id="uploadForm">

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div id="dropZone" class="drop-zone"
                         onclick="document.getElementById('File').click()"
                         ondragover="onDragOver(event)"
                         ondragleave="onDragLeave(event)"
                         ondrop="handleDrop(event)">
                        <i class="drop-zone-icon bi bi-file-earmark-pdf-fill"></i>
                        <p class="drop-zone-text">Drag & drop your PDF here</p>
                        <p class="drop-zone-sub">or <span style="color:var(--accent-light)">click to browse files</span></p>
                    </div>

                    <input asp-for="File" type="file" accept=".pdf"
                           class="d-none" id="File" onchange="onFileSelected()" />
                    <div id="fileLabel" class="text-center mt-2"></div>
                    <span asp-validation-for="File" class="text-danger small d-block mt-1"></span>

                    @if (ViewData["AnalysisDiagnostics"] is string diagnostics)
                    {
                        <details class="mt-2">
                            <summary class="small" style="color:var(--text-muted)">Diagnostics (Development only)</summary>
                            <pre class="small mt-2 mb-0" style="color:var(--text-muted);white-space:pre-wrap">@diagnostics</pre>
                        </details>
                    }

                    <button type="submit" id="submitBtn" class="btn-glow w-100 mt-4" disabled>
                        <i class="bi bi-cpu me-2"></i>Run AI Analysis
                    </button>
                </form>

                <div id="loadingMsg" class="ai-loader d-none">
                    <div class="loader-ring"></div>
                    <p class="loader-text">
                        Running AI analysis<br>
                        <small>Extracting text, keywords &amp; summary…</small>
                    </p>
                    <div class="loader-dots">
                        <span></span><span></span><span></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="tips-card fade-in">
            <i class="bi bi-lightbulb-fill me-2" style="color:#fbbf24"></i>
            <strong>Tips:</strong>
            Use text-based (not scanned) PDFs for best results.
            Analysis takes 30–90 seconds and is saved to your History automatically.
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function onFileSelected() {
            const f = document.getElementById('File').files[0];
            if (!f) return;
            document.getElementById('fileLabel').innerHTML =
                '<span class="file-selected-label"><i class="bi bi-file-earmark-check"></i>' + f.name + '</span>';
            document.getElementById('submitBtn').disabled = false;
        }
        document.getElementById('uploadForm').addEventListener('submit', function () {
            document.getElementById('uploadForm').style.display = 'none';
            document.getElementById('fileLabel').style.display = 'none';
            document.getElementById('loadingMsg').classList.remove('d-none');
        });
    </script>
}